# AWS Configuration
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# Agent Configuration
AGENT_NAME=scverse_research_agent
# These Claude models are accessed through Amazon Bedrock (a managed service),
# not the Anthropic API directly. The IDs below reference Bedrock-hosted models.
# Default model — Claude Opus 4.6 (best reasoning, cost estimates based on this)
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-20250514-v1:0
# Alternative — Claude Sonnet 4.6 (faster, lower cost)
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20250514-v1:0
# Fallback — Claude Haiku 4.5 (cheapest, works out of the box with cross-region inference)
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Check available models: aws bedrock list-foundation-models --region us-west-2 --query "modelSummaries[?contains(modelId,'claude')].modelId"

# AgentCore Memory (set after deployment)
AGENTCORE_MEMORY_ID=

# Observability
LOG_LEVEL=INFO
OBSERVABILITY_LEVEL=STANDARD
